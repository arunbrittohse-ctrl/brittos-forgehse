# Production. Never commit real values; inject them from the hosting platform's secret store.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/forgehse?sslmode=verify-full
# HTTPS only — the server refuses to start in production with COOKIE_SECURE=false.
COOKIE_SECURE=true
CORS_ORIGINS=https://forgehse.example.com
# disk (single server with a persistent volume) or postgres (serverless hosts without a disk).
STORAGE_DRIVER=disk
STORAGE_DIR=/app/storage
LOG_LEVEL=info
AI_PROVIDER=local
# Optional: self-hosted model or Claude (paid) — see .env.example.
# First administrator (only used when the database has no users yet):
# SEED_ORG_NAME=  SEED_ORG_SLUG=  SEED_ADMIN_EMAIL=  SEED_ADMIN_PASSWORD=
