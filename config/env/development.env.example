# Local development. Copy to .env.development (git-ignored) and load with:
#   set -a; . ./.env.development; set +a
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://forgehse:devpass@127.0.0.1:5432/forgehse_dev
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:4000,http://localhost:4000
STORAGE_DRIVER=disk
STORAGE_DIR=./storage
WEB_DIST_DIR=apps/web/dist
MIGRATIONS_DIR=apps/api/migrations
LOG_LEVEL=debug
# Free deterministic AI (no key, no network). Switch to openai_compatible for a local Ollama model.
AI_PROVIDER=local
