# Automated tests. The suites build their own config; this file documents what they need.
# TEST_DATABASE_URL must point at a DEDICATED, DISPOSABLE database: the suites drop and recreate its schema.
NODE_ENV=test
TEST_DATABASE_URL=postgres://forgehse:devpass@127.0.0.1:5432/forgehse_test
LOG_LEVEL=error
# Browser e2e (apps/web/e2e/run.mjs) against a running server seeded with `npm run seed -- --demo`:
BASE_URL=http://127.0.0.1:4000
# E2E_AI=1 also exercises AI Studio; with AI_PROVIDER=local on the server no AI key or mock is needed.
