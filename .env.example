# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# docker-compose builds DATABASE_URL from this password.
POSTGRES_PASSWORD=change-me-long-random
# For non-compose deployments set the full URL. Use sslmode=verify-full for remote databases.
# DATABASE_URL=postgres://forgehse:password@db.example.internal:5432/forgehse?sslmode=verify-full
DB_POOL_MAX=10

# --- Web / sessions --------------------------------------------------------
NODE_ENV=production
PORT=4000
# Must be true in production (HTTPS only). The server refuses to start otherwise.
COOKIE_SECURE=true
# Comma-separated browser origins allowed to call the API cross-origin (same-origin needs nothing).
CORS_ORIGINS=https://forgehse.example.com
SESSION_TTL_HOURS_WEB=12
SESSION_TTL_HOURS_MOBILE=336
MAX_UPLOAD_MB=15
LOG_LEVEL=info

# --- AI (no paid service required) -----------------------------------------
# auto (default): Claude if ANTHROPIC_API_KEY is set, otherwise the free local rules engine.
# local: FORGEHSE rules engine only (no model, no cost, deterministic, clearly labelled).
# openai_compatible: a self-hosted open model, e.g. Ollama → LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
# off: AI features disabled.
AI_PROVIDER=auto
# LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_AI_MODEL=llama3.1:8b
# LOCAL_AI_API_KEY=
# LOCAL_AI_TIMEOUT_MS=180000

# --- Claude (optional, paid, external) -------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=2000
CLAUDE_TIMEOUT_MS=60000
# 5m (default) or 1h. Only use 1h when the AI usage dashboard shows reuse gaps longer than 5 minutes
# and verified pricing shows the higher write cost pays off.
CLAUDE_CACHE_TTL=5m
AI_RATE_LIMIT_PER_HOUR=60
# Verified price table (see config/ai-pricing.example.json). Without it, costs use unverified defaults.
# AI_PRICING_FILE=/app/config/ai-pricing.json

# --- First-run bootstrap (npm run seed / node dist/cli/seed.js) -------------
# SEED_ORG_NAME=Your Company LLC
# SEED_ORG_SLUG=your-company
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Your Name
