# BRITTO'S FORGEHSE — local development only
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgres://forgehse:replace-with-local-password@127.0.0.1:5432/forgehse_dev
DB_POOL_MAX=5
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
SESSION_TTL_HOURS_WEB=12
SESSION_TTL_HOURS_MOBILE=336
STORAGE_DIR=./storage
STORAGE_DRIVER=disk
MAX_UPLOAD_MB=15
LOG_LEVEL=debug

# Optional live AI: may incur third-party charges. Keep keys server-side only.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=2000
CLAUDE_TIMEOUT_MS=60000
CLAUDE_CACHE_TTL=5m
AI_RATE_LIMIT_PER_HOUR=60
