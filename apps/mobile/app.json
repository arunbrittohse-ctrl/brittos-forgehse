{
  "expo": {
    "name": "BRITTO'S FORGEHSE",
    "slug": "brittos-forgehse",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0B1F3B",
    "android": {
      "package": "com.brittosaiforge.forgehse",
      "versionCode": 1,
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F3B"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "FORGEHSE uses the camera to photograph hazards you report.",
          "photosPermission": "FORGEHSE attaches photos you choose to the hazards you report."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": ""
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F3B"
    }
  }
}
