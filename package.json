{
  "name": "forgehse",
  "private": true,
  "version": "0.2.0",
  "description": "BRITTO'S FORGEHSE — AI-Powered HSE Intelligence Platform",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @forgehse/api",
    "dev:web": "npm run dev -w @forgehse/web",
    "migrate": "npm run migrate -w @forgehse/api --",
    "seed": "npm run seed -w @forgehse/api --",
    "test": "npm run test -w @forgehse/shared && npm run test -w @forgehse/web && npm run test -w @forgehse/api",
    "typecheck": "npm run typecheck -w @forgehse/shared && npm run typecheck -w @forgehse/api && npm run typecheck -w @forgehse/web",
    "build": "npm run build -w @forgehse/api && npm run build -w @forgehse/web",
    "e2e": "npm run e2e -w @forgehse/web",
    "mock:ai": "node scripts/dev/mock-anthropic.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/composer": "0.28.0",
    "@prisma/composer-prisma-cloud": "0.28.0",
    "alchemy": "2.0.0-beta.78",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "prisma": "8.0.0-rc.21"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@effect/sql-d1": "4.0.0-rc.115",
    "@effect/sql-mysql2": "4.0.0-rc.115",
    "@effect/sql-pg": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  }
}
